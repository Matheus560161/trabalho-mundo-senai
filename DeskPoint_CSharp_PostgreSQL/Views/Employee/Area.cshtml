@{ ViewData["Title"] = "Minha área"; var employee = ViewBag.Employee as Employee; var punches = ViewBag.Punches as List<Punch> ?? new(); }@if (employee != null) { <div class="dashboard-head"><div><span class="eyebrow">ESPAÇO DO FUNCIONÁRIO</span><h1>Olá, @employee.Name.Split(' ')[0]<span class="heading-period">.</span></h1><p class="lead small-lead">Aqui estão suas tarefas e seus registros recentes.</p></div><form asp-action="Logout" method="post">@Html.AntiForgeryToken()<button class="btn btn-quiet">Sair ↗</button></form></div><div class="employee-area-grid"><section class="surface"><div class="section-heading"><div><span class="eyebrow">ORGANIZE SUA ROTINA</span><h2>Minhas tarefas</h2></div><span class="count-chip">@employee.Tasks.Count(t => !t.Done) pendentes</span></div>@if (employee.Tasks.Count == 0) { <div class="empty-state"><span>☷</span><b>Você ainda não tem tarefas</b><p>Quando o chefe adicionar tarefas, elas aparecerão aqui.</p></div> }@foreach (var task in employee.Tasks.OrderBy(t => t.Done).ThenBy(t => t.CreatedAt)) { <div class="personal-task"><form asp-action="ToggleTask" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@task.Id"/><button class="check-button @(task.Done ? "checked" : "")">@(task.Done ? "✓" : "")</button><span class="@(task.Done ? "task-done" : "")">@task.Title</span></form><span class="task-state @(task.Done ? "state-done" : "")">@(task.Done ? "Concluída" : "Pendente")</span></div> }</section><section class="surface"><div class="section-heading"><div><span class="eyebrow">SEU HISTÓRICO</span><h2>Meus registros</h2></div></div>@if (punches.Count == 0) { <div class="empty-state"><span>◷</span><b>Nenhum ponto registrado</b><p>Use o cartão RFID para registrar entrada e saída.</p></div> } else { @foreach (var p in punches) { <div class="record-row"><span class="record-dot @(p.Kind == "entrada" ? "dot-in" : "dot-out")"></span><div class="record-person"><b>@p.Kind</b><small>@p.PunchedAt.ToLocalTime().ToString("dd/MM/yyyy")</small></div><div class="record-time"><b>@p.PunchedAt.ToLocalTime().ToString("HH:mm:ss")</b></div></div> } }</section></div> }
