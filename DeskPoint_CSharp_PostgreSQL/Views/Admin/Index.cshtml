@{ ViewData["Title"] = "Painel do chefe"; var employees = ViewBag.Employees as List<Employee> ?? new(); var punches = ViewBag.Punches as List<Punch> ?? new(); int totalTasks = ViewBag.TotalTasks ?? 0; int todayPunches = ViewBag.TodayPunches ?? 0; }
<div class="dashboard-head"><div><span class="eyebrow">ESPAÇO DE GESTÃO</span><h1>Painel do chefe<span class="heading-period">.</span></h1><p class="lead small-lead">Visão geral da equipe e das atividades.</p></div><form asp-action="Logout" method="post">@Html.AntiForgeryToken()<button class="btn btn-quiet">Sair ↗</button></form></div>@if (TempData["Message"] != null) { <div class="alert alert-success">@TempData["Message"]</div> }<section class="stats-grid"><div class="stat-card"><span>Funcionários ativos</span><b>@employees.Count <small>/ 5</small></b><i>♙</i></div><div class="stat-card"><span>Tarefas pendentes</span><b>@totalTasks</b><i>☷</i></div><div class="stat-card"><span>Registros de ponto hoje</span><b>@todayPunches</b><i>◷</i></div></section><div class="admin-grid"><section class="surface"><div class="section-heading"><div><span class="eyebrow">SUA EQUIPE</span><h2>Funcionários</h2></div><span class="count-chip">@employees.Count cadastrados</span></div>@if (employees.Count == 0) { <div class="empty-state"><span>♙</span><b>Nenhum funcionário cadastrado</b><p>Adicione a primeira pessoa para começar.</p></div> }@foreach (var e in employees) { <article class="employee-card"><div class="employee-top"><span class="person-avatar">@e.Name.Substring(0,1).ToUpperInvariant()</span><div class="employee-name"><b>@e.Name</b><small>Código de acesso: <code>@e.Code</code></small></div><span class="active-chip">Ativo</span><form asp-action="Fire" method="post" class="inline-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.Id"/><button class="icon-button danger-text" title="Desativar funcionário" onclick="return confirm('Desativar @e.Name? O histórico será preservado.')">×</button></form></div><details class="rfid-details"><summary>Cartão RFID <span>@(e.RfidUid ?? "Não associado")</span></summary><form asp-action="UpdateRfid" method="post" class="rfid-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.Id"/><input name="rfidUid" value="@e.RfidUid" placeholder="UID do cartão (ex.: A1B2C3D4)"/><button class="btn btn-outline btn-xs">Salvar cartão</button></form></details><div class="task-section"><div class="task-title-row"><b>Tarefas</b><span>@e.Tasks.Count(t => t.Done)/@e.Tasks.Count concluídas</span></div>@foreach (var task in e.Tasks.OrderBy(t => t.CreatedAt)) { <div class="task-row"><form asp-action="ToggleTask" method="post" class="inline-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@task.Id"/><button class="check-button @(task.Done ? "checked" : "")">@(task.Done ? "✓" : "")</button><span class="@(task.Done ? "task-done" : "")">@task.Title</span></form><form asp-action="DeleteTask" method="post" class="inline-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@task.Id"/><button class="tiny-delete" title="Excluir tarefa">×</button></form></div> }<form asp-action="AddTask" method="post" class="add-task-form">@Html.AntiForgeryToken()<input type="hidden" name="employeeId" value="@e.Id"/><input name="title" placeholder="Adicionar uma tarefa…" required maxlength="250"/><button aria-label="Adicionar tarefa">+</button></form></div></article> }@if (employees.Count < 5) { <div class="add-employee"><div class="add-heading"><span class="plus-icon">+</span><div><b>Adicionar funcionário</b><small>Você pode cadastrar até 5 funcionários ativos.</small></div></div><form asp-action="AddEmployee" method="post" class="add-employee-form">@Html.AntiForgeryToken()<label>Nome completo</label><input name="name" required maxlength="100" placeholder="Ex.: Ana Souza"/><label>UID do cartão RFID <span>(opcional)</span></label><input name="rfidUid" maxlength="32" placeholder="Ex.: A1B2C3D4"/><button class="btn btn-primary full">Cadastrar funcionário <span>↗</span></button></form></div> }</section><section class="surface records-surface"><div class="section-heading"><div><span class="eyebrow">ACOMPANHAMENTO</span><h2>Registros de ponto</h2></div><span class="count-chip">Últimos 100</span></div>@if (punches.Count == 0) { <div class="empty-state"><span>◷</span><b>Sem registros por enquanto</b><p>Os pontos registrados pelo leitor aparecerão aqui.</p></div> } else { <div class="records-list">@foreach (var p in punches) { <div class="record-row"><span class="record-dot @(p.Kind == "entrada" ? "dot-in" : "dot-out")"></span><div class="record-person"><b>@p.Employee?.Name</b><small>@p.PunchedAt.ToLocalTime().ToString("dd/MM/yyyy")</small></div><div class="record-time"><b>@p.PunchedAt.ToLocalTime().ToString("HH:mm:ss")</b><span class="record-kind">@p.Kind</span></div></div> }</div> }</section></div>
