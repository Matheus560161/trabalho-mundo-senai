@{ ViewData["Title"] = "Minha área"; }<section class="simple-auth"><a asp-controller="Home" asp-action="Index" class="back-link">← Início</a><span class="auth-icon">♙</span><span class="eyebrow">ESPAÇO DO FUNCIONÁRIO</span><h1>Olá! Vamos<br/><em>organizar o dia.</em></h1><p class="muted">Digite o código que o chefe forneceu para acessar suas tarefas e seus registros.</p>@if (ViewBag.Error != null) { <div class="alert alert-error">@ViewBag.Error</div> }<form asp-action="Login" method="post" class="stack-form">@Html.AntiForgeryToken()<label>Seu código de acesso</label><input name="code" required maxlength="8" placeholder="Ex.: A1B2C3" autocapitalize="characters"/><button class="btn btn-primary full">Acessar minha área ↗</button></form><p class="fine-print">Não sabe seu código? Peça ao responsável pelo sistema.</p></section>
